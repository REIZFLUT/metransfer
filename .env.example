APP_NAME=MeTransfer
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="transfer@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MeTransfer
# TRANSFERS_DISK=local
# TRANSFERS_CHUNK_SIZE=10485760
# TRANSFERS_MAX_FILE_SIZE=0
# TRANSFERS_DEFAULT_EXPIRY_DAYS=7
# TRANSFERS_DRAFT_LIFETIME_HOURS=24
# TRANSFERS_NOTIFICATION_COOLDOWN=60

# Länder-Sperre für Login und Verwaltung (Download-Links bleiben weltweit erreichbar)
GEOBLOCK_ENABLED=false
GEOBLOCK_COUNTRIES=DE
GEOBLOCK_ALLOWED_IPS=
# TRUSTED_PROXIES=*
# Länderdatenbank: dbip (Standard, ohne Account) oder maxmind (Account + Lizenzschlüssel nötig)
GEOIP_SOURCE=dbip
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=
